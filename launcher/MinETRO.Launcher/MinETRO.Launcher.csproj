<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>MinETRO-Launcher</AssemblyName><Version>0.5.0</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/minetro.ico</ApplicationIcon><Product>MinETRO Launcher</Product><Description>MinETRO Launcher</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MinETRO.Core/MinETRO.Core.csproj"/>
    <Content Include="../third-party/**/*" Link="third-party/%(RecursiveDir)%(Filename)%(Extension)" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="../accounts.public.json" Link="accounts.public.json" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Assets/*.jpg;Assets/*.png;Assets/*.ico" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
